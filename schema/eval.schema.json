{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://realbench.local/schema/eval.schema.json",
  "title": "评测记录 (eval)",
  "description": "开环评测和真机（闭环）评测共用的外壳。每条评测只指向一个 checkpoint，部署配置单独成块，这样才能沿 数据→训练→checkpoint→部署→评测 的链归因。",
  "type": "object",
  "required": ["id", "type", "date", "run_id", "checkpoint", "task", "protocol"],
  "additionalProperties": false,
  "properties": {
    "id": {"type": "string", "pattern": "^ev-[a-z0-9][a-z0-9-]*$"},
    "type": {"type": "string", "enum": ["open_loop", "closed_loop"]},
    "date": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$", "description": "本地日期"},
    "owner": {"type": "string"},
    "run_id": {"type": "string", "pattern": "^tr-"},
    "checkpoint": {
      "type": "object",
      "required": ["step"],
      "properties": {
        "step": {"type": "integer"},
        "sha256": {"type": ["string", "null"], "description": "服务实际加载的权重哈希。真机评测务必填，否则无法确认跑的是哪个权重"}
      }
    },
    "task": {"type": "string", "description": "任务名，同一任务全仓库用同一写法"},
    "instruction": {"type": ["string", "null"], "description": "给模型的提示词原文"},
    "protocol": {
      "type": "object",
      "required": ["name", "version"],
      "properties": {
        "name": {"type": "string"},
        "version": {"type": "string", "description": "协议文件的内容哈希前 8 位；改任何一项就是新版本"}
      }
    },
    "deployment": {
      "type": "object",
      "description": "真机评测专用。同一个 checkpoint 换了这里任何一项，就是另一个系统",
      "properties": {
        "robot": {"type": "string"},
        "driver": {"type": ["string", "null"], "description": "例如 kd=5"},
        "server": {
          "type": "object",
          "properties": {
            "host": {"type": ["string", "null"]},
            "port": {"type": ["integer", "null"]},
            "protocol": {"type": ["string", "null"]},
            "started": {"type": ["string", "null"], "description": "服务进程启动时间，用来排除端口被换成别的模型"},
            "model_dir": {"type": ["string", "null"]}
          }
        },
        "client": {
          "type": "object",
          "properties": {
            "name": {"type": ["string", "null"]},
            "git_hash": {"type": ["string", "null"]},
            "args": {"type": "object", "description": "客户端参数原样，例如 replan、blend、time_scale、rtc_mode"},
            "loop_hz": {"type": ["number", "null"], "description": "实测控制循环频率，不是配置值"}
          }
        },
        "extra": {"type": "object"}
      }
    },
    "prediction": {
      "type": "object",
      "description": "跑之前写的预测，带时间戳。事后补写的标 after_the_fact=true，页面上会标出来",
      "properties": {
        "text": {"type": "string"},
        "falsified_if": {"type": ["string", "null"]},
        "written_at": {"type": ["string", "null"]},
        "after_the_fact": {"type": "boolean"}
      }
    },
    "open_loop": {
      "type": "object",
      "properties": {
        "num_requests": {"type": "integer"},
        "num_seeds": {"type": "integer"},
        "metrics": {"type": "object", "description": "指标名到数值，如 l1_arm、l1_gripper、seed_spread"},
        "curve_file": {"type": ["string", "null"]}
      }
    },
    "closed_loop": {
      "type": "object",
      "properties": {
        "trials": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["n", "result"],
            "properties": {
              "n": {"type": "integer", "minimum": 1},
              "result": {"type": "string", "enum": ["success", "fail", "partial", "invalid", "unlabeled"], "description": "unlabeled 表示还没人看视频标注，导入器只能给这个值"},
              "duration_s": {"type": ["number", "null"]},
              "failure_mode": {"type": ["string", "null"]},
              "label_by": {"type": ["string", "null"], "description": "谁标的成败"},
              "run_dir": {"type": ["string", "null"], "description": "机器上的运行目录名，用来回溯原始日志"},
              "videos": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["camera", "url"],
                  "properties": {
                    "camera": {"type": "string"},
                    "url": {"type": "string"},
                    "sha256": {"type": ["string", "null"]}
                  }
                }
              },
              "note": {"type": "string"}
            }
          }
        },
        "min_trials_required": {"type": "integer", "default": 3}
      }
    },
    "conclusion": {"type": "string"},
    "tags": {"type": "array", "items": {"type": "string"}},
    "source": {
      "type": "object",
      "required": ["kind"],
      "properties": {
        "kind": {"type": "string", "enum": ["auto-import", "manual"]},
        "path": {"type": "string"},
        "imported_at": {"type": ["string", "null"]},
        "importer_version": {"type": ["string", "null"]}
      }
    }
  }
}
