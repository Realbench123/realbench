{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://realbench.local/schema/stack.schema.json",
  "title": "训练栈 (training stack)",
  "description": "怎么复现一次训练：解释器、源码快照、镜像、提交入口、配置目录、监控位置。不放凭据和带令牌的地址。",
  "type": "object",
  "required": [
    "id",
    "name",
    "family",
    "source"
  ],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^st-[a-z0-9][a-z0-9-]*$"
    },
    "name": {
      "type": "string"
    },
    "family": {
      "type": "string"
    },
    "framework": {
      "type": "string",
      "description": "如 tau0_vla、lerobot、OpenWAM"
    },
    "base_models": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "format": {
            "type": [
              "string",
              "null"
            ]
          },
          "location_label": {
            "type": "string"
          },
          "sha256": {
            "type": [
              "string",
              "null"
            ]
          },
          "license": {
            "type": [
              "string",
              "null"
            ]
          },
          "url": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "runtime": {
      "type": "object",
      "properties": {
        "image": {
          "type": [
            "string",
            "null"
          ]
        },
        "interpreter": {
          "type": [
            "string",
            "null"
          ]
        },
        "source_snapshot": {
          "type": [
            "string",
            "null"
          ]
        },
        "snapshot_checksums": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "python": {
          "type": [
            "string",
            "null"
          ]
        },
        "note": {
          "type": "string"
        }
      }
    },
    "compute": {
      "type": "object",
      "properties": {
        "platform": {
          "type": [
            "string",
            "null"
          ]
        },
        "group": {
          "type": [
            "string",
            "null"
          ]
        },
        "gpu_type": {
          "type": [
            "string",
            "null"
          ]
        },
        "typical": {
          "type": "string",
          "description": "典型配置，如 8×H100、每卡 batch16"
        }
      }
    },
    "entrypoints": {
      "type": "object",
      "properties": {
        "submit": {
          "type": [
            "string",
            "null"
          ]
        },
        "node": {
          "type": [
            "string",
            "null"
          ]
        },
        "cli": {
          "type": [
            "string",
            "null"
          ]
        },
        "smoke": {
          "type": [
            "string",
            "null"
          ],
          "description": "是否先跑 smoke、怎么判通过"
        }
      }
    },
    "config_variants": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "config_dir": {
            "type": [
              "string",
              "null"
            ]
          },
          "task": {
            "type": [
              "string",
              "null"
            ]
          },
          "action_mode": {
            "type": [
              "string",
              "null"
            ],
            "description": "absolute / relative 等"
          },
          "differs": {
            "type": "string",
            "description": "相对基础配置改了什么"
          },
          "recipe_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "preparation_dir": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "monitoring": {
      "type": "object",
      "properties": {
        "tensorboard": {
          "type": [
            "string",
            "null"
          ]
        },
        "wandb": {
          "type": [
            "string",
            "null"
          ]
        },
        "status_file": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "known_issues": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "what"
        ],
        "properties": {
          "what": {
            "type": "string"
          },
          "fix": {
            "type": [
              "string",
              "null"
            ]
          },
          "seen_in": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "docs": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "label": {
            "type": "string"
          },
          "path": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "used_by_runs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "notes": {
      "type": "string"
    },
    "source": {
      "type": "object",
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "auto-import",
            "manual"
          ]
        },
        "path": {
          "type": "string"
        },
        "imported_at": {
          "type": [
            "string",
            "null"
          ]
        },
        "importer_version": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    }
  }
}